<?php function create_review(int$eid,int$rev,string$start,string$end):int{global$db;$db->query("INSERT INTO ".TB_PREF."performance_reviews(employee_id,reviewer_id,period_start,period_end)VALUES(".$eid.",".$rev.",".$db->escape($start).",".$db->escape($end).")");return$db->insert_id;} function get_reviews(array$f=[]):?object{global$db;$s="SELECT r.*,e.name as employee_name FROM ".TB_PREF."performance_reviews r LEFT JOIN ".TB_PREF."hr_employees e ON r.employee_id=e.id WHERE 1=1";if(!empty($f['employee_id']))$s.=" AND r.employee_id=".$f['employee_id'];$s.=" ORDER BY r.period_end DESC";return$db->query($s);} function submit_review(int$id,float$rating,string$str,string$imp,string$goals):bool{global$db;return$db->query("UPDATE ".TB_PREF."performance_reviews SET status='Submitted',overall_rating=".$rating.",strengths=".$db->escape($str).",improvements=".$db->escape($imp).",goals=".$db->escape($goals).",submitted_at=NOW() WHERE id=".$id);}